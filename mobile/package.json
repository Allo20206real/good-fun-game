{
  "name": "bounce-duel",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~58.0.19",
    "expo-haptics": "~58.0.7",
    "expo-keep-awake": "~58.0.3",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "sync-game": "node scripts/sync-game.js",
    "prestart": "npm run sync-game",
    "start": "expo start",
    "android": "npm run sync-game && expo start --android",
    "ios": "npm run sync-game && expo start --ios",
    "web": "npm run sync-game && expo start --web",
    "build:ios": "npm run sync-game && npx eas-cli@latest build --platform ios --profile production",
    "submit:ios": "npx eas-cli@latest submit --platform ios --latest",
    "release:ios": "npm run sync-game && npx eas-cli@latest build --platform ios --profile production --auto-submit"
  },
  "private": true
}
