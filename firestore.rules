rules_version = '2';

// Security rules for Bounce Duel. Paste these into Firebase console → Firestore Database → Rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function validUser(d) {
      return d.keys().hasOnly(['name', 'score', 'coins', 'skins', 'wins1p', 'losses1p', 'wins2p', 'losses2p', 'groups', 'daily', 'streak'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 16
        && d.score is int && d.score >= 0
        && d.coins is int && d.coins >= 0
        && d.skins is list && d.skins.size() <= 30
        && d.groups is list && d.groups.size() <= 10
        && d.wins1p is int && d.losses1p is int && d.wins2p is int && d.losses2p is int
        && d.daily is map && d.streak is map;
    }

    // Player accounts. Anyone signed in can read them (for leaderboards); only the owner can change theirs.
    match /users/{uid} {
      allow read: if signedIn();

      allow create: if signedIn() && request.auth.uid == uid
        && validUser(request.resource.data)
        && request.resource.data.score == 100
        && request.resource.data.coins == 50
        && request.resource.data.skins.size() == 2;

      allow update: if signedIn() && request.auth.uid == uid
        && validUser(request.resource.data)
        // A two-player match moves the score by at most 100
        && request.resource.data.score - resource.data.score <= 100
        && resource.data.score - request.resource.data.score <= 100
        // No single save can add more than 300 coins
        && request.resource.data.coins - resource.data.coins <= 300
        // A new skin has to be paid for
        && (request.resource.data.skins.size() == resource.data.skins.size()
            || (request.resource.data.skins.size() == resource.data.skins.size() + 1
                && resource.data.coins - request.resource.data.coins >= 50));
    }

    // Friend groups. The doc id is the 6-character invite code.
    match /groups/{code} {
      allow read: if signedIn();

      allow create: if signedIn()
        && code.matches('^[A-Z0-9]{6}$')
        && request.resource.data.keys().hasOnly(['name', 'owner', 'members'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 24
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.members == [request.auth.uid];

      // Members can only add or remove themselves
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        && (
          (request.resource.data.members.hasAll(resource.data.members)
            && request.resource.data.members.size() == resource.data.members.size() + 1
            && request.resource.data.members.size() <= 30
            && request.auth.uid in request.resource.data.members
            && !(request.auth.uid in resource.data.members))
          ||
          (resource.data.members.hasAll(request.resource.data.members)
            && request.resource.data.members.size() == resource.data.members.size() - 1
            && request.auth.uid in resource.data.members
            && !(request.auth.uid in request.resource.data.members))
        );

      allow delete: if signedIn() && resource.data.owner == request.auth.uid && resource.data.members.size() <= 1;
    }
  }
}
